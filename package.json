{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio website",
  "scripts": {
    "devserver": "serve . -p 8124",
    "watch:sass": "node-sass sass/main.scss assets/css/main.css -w",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "node-sass sass/main.scss assets/css/main.comp.css",
    "prefix:css": "postcss assets/css/main.comp.css --use autoprefixer -b 'last 10 versions' --no-map -o assets/css/main.prefix.css",
    "compress:css": "postcss assets/css/main.prefix.css --use cssnano --no-map -o assets/css/main.css",
    "build:css": "npm-run-all compile:sass prefix:css compress:css",
    "build": "npm-run-all build:css"
  },
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "cssnano": "^6.0.1",
    "node-sass": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^10.1.0",
    "serve": "^14.2.6"
  }
}
